# =============================================================================
# Nobreza ERP — Configuração de Ambiente
# =============================================================================
# Copie este ficheiro para `.env` e preencha os valores reais.
# O `.env` NUNCA deve ser versionado no Git.
#
# Na Hostinger, estas variáveis são definidas no hPanel em:
#   Websites -> Gerir -> Node.js -> Variáveis de Ambiente
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=production
# A Hostinger injeta a PORT automaticamente. Localmente, 3001 evita colidir com o Vite.
PORT=3001
# Origem pública do sistema. Usada para CORS, cookies e links nos e-mails.
APP_URL=https://app.nobreza.site

# -----------------------------------------------------------------------------
# Base de dados MySQL (Hostinger)
# -----------------------------------------------------------------------------
# No hPanel: Bases de Dados -> MySQL.
#
# DB_HOST tem duas opções:
#   localhost         quando a aplicação Node corre na MESMA conta Hostinger
#                     da base de dados. É o caminho mais rápido e não exige
#                     qualquer configuração adicional. Prefira esta.
#   app.nobreza.site  ligação remota, a partir de outro servidor. Exige
#                     ativar "MySQL Remoto" no hPanel e autorizar lá o IP de
#                     origem, senão a ligação é recusada pelo servidor.
DB_HOST=localhost
DB_PORT=3306
# Nome da base de dados e do utilizador, tal como aparecem no hPanel
# (a Hostinger prefixa ambos com o número da conta).
DB_NAME=
DB_USER=
DB_PASSWORD=
# Número máximo de ligações simultâneas no pool.
DB_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------
# Segredo de assinatura dos tokens de sessão (JWT).
# Gere com: openssl rand -base64 48
JWT_SECRET=
# Segredo separado para os tokens de renovação. TEM de ser diferente do JWT_SECRET.
JWT_REFRESH_SECRET=
# Duração do token de acesso e do token de renovação.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Chave de cifra para dados sensíveis guardados na base de dados
# (passwords SMTP/IMAP das contas de e-mail).
# TEM de ter exatamente 32 bytes em base64. Gere com: openssl rand -base64 32
# ATENÇÃO: se esta chave mudar, as credenciais já guardadas deixam de poder ser lidas.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# E-mail (SMTP da Hostinger)
# -----------------------------------------------------------------------------
# No hPanel: E-mails -> Contas de E-mail -> Definições de Configuração.
# A porta 465 usa SSL desde a ligação (SMTP_SECURE=true). A alternativa é a
# porta 587 com STARTTLS, e nesse caso SMTP_SECURE tem de ser false.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mail@app.nobreza.site
SMTP_PASSWORD=
# Remetente fixo. O cliente nunca escolhe o remetente — foi essa liberdade que
# tornou a Edge Function anterior um relay aberto.
MAIL_FROM_NAME=Nobreza ERP
MAIL_FROM_ADDRESS=mail@app.nobreza.site

# Receção de e-mail (módulo de caixa de correio dentro do ERP).
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true

# -----------------------------------------------------------------------------
# Assistente de IA (opcional)
# -----------------------------------------------------------------------------
# Deixe vazio para desativar o assistente. A chave vive apenas no servidor
# e nunca é enviada para o browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# Caminho no disco onde ficam os ficheiros carregados pelos utilizadores.
UPLOAD_DIR=./uploads
# Tamanho máximo por ficheiro, em bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# -----------------------------------------------------------------------------
# Seed inicial (usado apenas por `npm run db:seed`)
# -----------------------------------------------------------------------------
SEED_COMPANY_NAME=Farmácia Nobreza
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@nobreza.site
# Se ficar vazio, o script gera uma password aleatória e imprime-a uma única vez.
SEED_ADMIN_PASSWORD=
